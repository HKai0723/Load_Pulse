__pycache__/
*.pyc
*.db
.env
archive/

# 排除龐大的原始未加工資料（改由本機與 Google 雲端備份保存）
data/raw/

# 預設排除所有大型 CSV，但放行外部假日／緊急停班表與指定的單年抽樣 CSV
*.csv
!data/external/*.csv
!data/processed/*_sample_*.csv

# 僅放行 data/processed/ 下的正式 Parquet 產物與指紋清單（排除其餘位置暫存 Parquet）
*.parquet
!data/processed/*.parquet
!data/processed/*_manifest.json